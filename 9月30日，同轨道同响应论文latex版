\section{Analytical Proof of the Involutive Automorphism Theorem}

\textbf{Theorem:} Let $\phi$ be a non-trivial involution of $G$, $\phi(e_1)=e_2$. Then the sorted correlation distribution with $e_1$ as defect edge is identical to that with $e_2$ as defect edge.

\textbf{Proof:} Since $\phi$ is a graph automorphism and $\phi(e_1)=e_2$, $H_2(s)=U_\phi H_1(s)U_\phi^\dagger$. The ground-state density matrix satisfies $\rho_2=U_\phi \rho_1 U_\phi^\dagger$. For any edge $f$, $\langle \sigma_f^z \sigma_{f'}^z \rangle_2 = \langle \sigma_{\phi^{-1}(f)}^z \sigma_{\phi^{-1}(f')}^z \rangle_1$. The sorted distribution is invariant under permutation. Hence $\mathcal{R}_{e_2}(s)=\mathcal{R}_{e_1}(s)$. $\square$

\section{Derivation of the SU(2) Singlet-Probability Theorem}

\textbf{Theorem:} For an SU(2)-symmetric ground state, the two-site reduced density matrix $\rho_{ij}$ is fully determined by a single scalar $p_S$, and the defect-edge correlation is
\begin{equation}
\langle \sigma_i^z \sigma_j^z \rangle = \frac{1}{3} - \frac{4 p_S}{3}, \quad \langle \boldsymbol{\sigma}_i \cdot \boldsymbol{\sigma}_j \rangle = 1 - 4 p_S.
\end{equation}

\textbf{Proof:} The two-site Hilbert space decomposes into the singlet sector (dim 1) and the triplet sector (dim 3). SU(2) symmetry implies
\begin{equation}
\rho_{ij} = p_S |S\rangle\langle S| + \frac{1-p_S}{3}\left(|T_+\rangle\langle T_+| + |T_0\rangle\langle T_0| + |T_-\rangle\langle T_-\right).
\end{equation}
The $z$-$z$ correlation is
\begin{equation}
\langle \sigma_i^z \sigma_j^z \rangle = p_S(-1) + \frac{1-p_S}{3}(+1 - 1 + 1) = \frac{1}{3} - \frac{4 p_S}{3}.
\end{equation}
By SU(2) symmetry, $\langle \boldsymbol{\sigma}_i \cdot \boldsymbol{\sigma}_j \rangle = 1 - 4 p_S$. $\square$

This theorem is verified numerically at $4293/4293$ sampling points with zero exceptions.

\section{Derivation of the Analytic Form of $p_S(s)$}

\textbf{Theorem:} For a defect edge with coupling $s$, the singlet probability satisfies
\begin{equation}
p_S(s) = \frac{1}{4}\left(1 - \frac{dE_0}{ds}\right),
\end{equation}
and is monotonically non-decreasing.

\textbf{Proof:} Write $H(s) = H_0 + s\, \boldsymbol{\sigma}_i\cdot\boldsymbol{\sigma}_j$. By the Hellmann-Feynman theorem, $dE_0/ds = \langle\boldsymbol{\sigma}_i\cdot\boldsymbol{\sigma}_j\rangle_{\text{defect}}$. Combined with $\langle\boldsymbol{\sigma}\cdot\boldsymbol{\sigma}\rangle = 1 - 4p_S$, this gives the stated form. Since $E_0(s)$ is the minimum of a family of functions linear in $s$, it is concave; therefore $dE_0/ds$ is non-increasing and $p_S(s)$ is non-decreasing. $\square$

